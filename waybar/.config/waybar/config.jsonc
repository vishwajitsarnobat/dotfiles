{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "modules-left":   ["niri/workspaces", "custom/media"],
    "modules-center": ["custom/clock", "niri/window"],
    "modules-right":  ["tray", "custom/awake", "custom/dnd", "pulseaudio", "network", "bluetooth", "battery", "custom/power"],

    "custom/clock": {
        "exec": "~/.local/bin/waybar-calendar",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "tooltip": true,
        "on-click": "~/.local/bin/waybar-calendar reset",
        "on-scroll-up": "~/.local/bin/waybar-calendar prev",
        "on-scroll-down": "~/.local/bin/waybar-calendar next",
        "smooth-scrolling-threshold": 3
    },

    "custom/media": {
        "exec": "~/.local/bin/waybar-media",
        "return-type": "json",
        "interval": 2,
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "custom/awake": {
        "exec": "~/.local/bin/keep-awake",
        "return-type": "json",
        "interval": 10,
        "signal": 10,
        "on-click": "~/.local/bin/keep-awake toggle"
    },

    "custom/dnd": {
        "exec": "~/.local/bin/dnd-status",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "~/.local/bin/dnd-toggle"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 40,
        "rewrite": {
            "": "Desktop",
            "^.*@.*:.*$": "Terminal"
        }
    },

    "niri/workspaces": {
        "format": "{index}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "Volume {volume}%",
        "on-click": "~/.local/bin/settings-panel sound",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "Wired",
        "tooltip-format-disconnected": "Offline",
        "on-click": "~/.local/bin/settings-panel wifi"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "~/.local/bin/settings-panel bluetooth"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}",
        "on-click": "~/.local/bin/settings-panel power"
    },

    "tray": {
        "icon-size": 17,
        "spacing": 8
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.local/bin/powermenu"
    }
}
