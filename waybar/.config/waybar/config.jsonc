{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 3,
    "margin-bottom": 0,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 0,

    "modules-left":   ["niri/workspaces", "custom/media"],
    "modules-center": ["custom/clock", "niri/window"],
    "modules-right":  ["tray", "custom/awake", "custom/dnd", "pulseaudio#mic", "pulseaudio", "network", "bluetooth", "power-profiles-daemon", "battery", "custom/power"],

    "custom/clock": {
        "exec": "~/.local/bin/waybar-calendar",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "tooltip": true,
        "on-click": "~/.local/bin/waybar-calendar reset",
        "on-scroll-up": "~/.local/bin/waybar-calendar prev",
        "on-scroll-down": "~/.local/bin/waybar-calendar next",
        "smooth-scrolling-threshold": 3
    },

    "custom/media": {
        "exec": "~/.local/bin/waybar-media",
        "return-type": "json",
        "restart-interval": 5,
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "custom/awake": {
        "exec": "~/.local/bin/keep-awake",
        "return-type": "json",
        "interval": 10,
        "signal": 10,
        "on-click": "~/.local/bin/keep-awake toggle"
    },

    "custom/dnd": {
        "exec": "~/.local/bin/dnd-status",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "~/.local/bin/dnd-toggle"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 40,
        "rewrite": {
            "": "Desktop",
            "^.*@.*:.*$": "Terminal"
        }
    },

    "niri/workspaces": {
        "format": "{index}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "tooltip-format": "Volume {volume}%\nClick: sound settings   Right-click: mute",
        "on-click": "~/.local/bin/settings-panel sound",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-muted": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "Microphone {source_volume}%\nClick: mute   Right-click: sound settings",
        "on-click": "~/.local/bin/volume mic-mute",
        "on-click-right": "~/.local/bin/settings-panel sound",
        "on-scroll-up": "",
        "on-scroll-down": ""
    },

    "network": {
        "format": "󰤨",
        "format-linked": "󰤫",
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nClick: Wi-Fi settings",
        "tooltip-format-ethernet": "Wired\nClick: network settings",
        "tooltip-format-disconnected": "Offline\nClick: Wi-Fi settings",
        "tooltip-format-linked": "Connecting…\nClick: Wi-Fi settings",
        "on-click": "~/.local/bin/settings-panel wifi"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}\nClick: Bluetooth settings",
        "tooltip-format-connected": "{device_alias}\nClick: Bluetooth settings",
        "on-click": "~/.local/bin/settings-panel bluetooth"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰾅",
            "power-saver": "󰾆",
            "balanced": "󰾅",
            "performance": "󰓅"
        },
        "tooltip-format": "Power: {profile}\nClick: next profile"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "<span font_family='JetBrainsMono Nerd Font' size='15360'>{icon}</span>  {capacity}%",
        "format-charging": "<span font_family='JetBrainsMono Nerd Font' size='15360'>󰂄</span>  {capacity}%",
        "format-plugged": "<span font_family='JetBrainsMono Nerd Font' size='15360'>󰂄</span>  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nClick: power settings",
        "on-click": "~/.local/bin/settings-panel power"
    },

    "tray": {
        "icon-size": 17,
        "spacing": 8
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "~/.local/bin/powermenu"
    }
}
