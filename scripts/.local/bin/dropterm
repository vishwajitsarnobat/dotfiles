#!/usr/bin/env bash
# Drop-down terminal: show it, focus it, or hide it.
# Hiding closes the window, but the tmux session inside keeps running,
# so the next show brings back the same shell, history and output.
id=$(niri msg -j windows | python3 -c '
import json, sys
w = [w for w in json.load(sys.stdin) if w["app_id"] == "dropterm"]
if w: print(w[0]["id"], w[0]["is_focused"])')
if [ -z "$id" ]; then
    exec alacritty --class dropterm -e tmux new-session -A -s dropdown \; set status off
fi
read -r win focused <<< "$id"
if [ "$focused" = True ]; then
    niri msg action close-window --id "$win"
else
    # Bring it to the current workspace first, then focus it
    cur=$(niri msg -j workspaces | python3 -c '
import json, sys
print(next(w["idx"] for w in json.load(sys.stdin) if w["is_focused"]))')
    niri msg action move-window-to-workspace --window-id "$win" --focus false "$cur"
    niri msg action focus-window --id "$win"
fi
