#!/usr/bin/env python3
# Calendar under the clock. Scroll or ←/→ for months, T for today.
import calendar, datetime, os, sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/dotfiles"))
import popup

popup.claim("calendar-popup")

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

TOP_GAP = 40            # bar height + margins, so the card sits just below it
FIRST_WEEKDAY = 6       # Sunday first

CSS = b"""
#card { padding: 16px 16px 14px 16px; margin: 6px 12px 16px 12px; }
#month { font-size: 15pt; font-weight: 600; color: #f2f2f5; }
#year  { font-size: 15pt; font-weight: 400; color: #8b8b96; }
.nav {
    background: transparent; border: none; box-shadow: none;
    color: #a8a8b3; font-size: 13pt;
    min-width: 30px; min-height: 30px; padding: 0; border-radius: 6px;
}
.nav:hover { background: rgba(255, 255, 255, 0.08); color: #f2f2f5; }
.weekday { color: #6b6b76; font-size: 9.5pt; font-weight: 600; }
.day {
    color: #e3e3e8; font-size: 11pt;
    min-width: 36px; min-height: 36px; border-radius: 999px;
}
.day:hover   { background: rgba(255, 255, 255, 0.08); }
.other       { color: #4a4a54; }
.today       { background: #8fb8f6; color: #1e1e22; font-weight: 600; }
.today:hover { background: #a9c9fa; }
"""


class Calendar:
    def __init__(self):
        today = datetime.date.today()
        self.year, self.month = today.year, today.month
        self.scroll_acc = 0.0

    def build(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, name="card")

        header = Gtk.Box(spacing=8)
        self.month_label = Gtk.Label(name="month", xalign=0)
        self.year_label = Gtk.Label(name="year", xalign=0)
        header.pack_start(self.month_label, False, False, 0)
        header.pack_start(self.year_label, False, False, 0)
        for text, step in (("›", 1), ("•", 0), ("‹", -1)):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("nav")
            b.connect("clicked", lambda _b, s=step: self.change(s))
            header.pack_end(b, False, False, 0)
        card.pack_start(header, False, False, 0)

        self.grid = Gtk.Grid(row_spacing=2, column_spacing=4, column_homogeneous=True)
        card.pack_start(self.grid, False, False, 0)


        self.draw_month()
        return card

    def change(self, step):
        if step == 0:
            t = datetime.date.today()
            self.year, self.month = t.year, t.month
        else:
            y, m = divmod(self.year * 12 + self.month - 1 + step, 12)
            self.year, self.month = y, m + 1
        self.draw_month()

    def draw_month(self):
        for child in self.grid.get_children():
            self.grid.remove(child)
        self.month_label.set_text(calendar.month_name[self.month])
        self.year_label.set_text(str(self.year))

        names = [calendar.day_abbr[(FIRST_WEEKDAY + i) % 7][:2] for i in range(7)]
        for col, name in enumerate(names):
            lbl = Gtk.Label(label=name)
            lbl.get_style_context().add_class("weekday")
            self.grid.attach(lbl, col, 0, 1, 1)

        today = datetime.date.today()
        weeks = calendar.Calendar(firstweekday=FIRST_WEEKDAY).monthdatescalendar(self.year, self.month)
        while len(weeks) < 6:                     # always 6 rows, so the card never jumps
            last = weeks[-1][-1]
            weeks.append([last + datetime.timedelta(days=i + 1) for i in range(7)])
        for row, week in enumerate(weeks, start=1):
            for col, day in enumerate(week):
                lbl = Gtk.Label(label=str(day.day))
                ctx = lbl.get_style_context()
                ctx.add_class("day")
                if day.month != self.month:
                    ctx.add_class("other")
                if day == today:
                    ctx.add_class("today")
                box = Gtk.EventBox()                # lets :hover work on the label
                box.add(lbl)
                self.grid.attach(box, col, row, 1, 1)
        self.grid.show_all()

    def on_scroll(self, event, Gdk):
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            self.scroll_acc += event.delta_y
            if abs(self.scroll_acc) >= 1:
                self.change(1 if self.scroll_acc > 0 else -1)
                self.scroll_acc = 0.0
        elif event.direction in (Gdk.ScrollDirection.DOWN, Gdk.ScrollDirection.RIGHT):
            self.change(1)
        elif event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            self.change(-1)

    def on_key(self, key):
        if key in ("Right", "Down", "l", "j", "Page_Down"):
            self.change(1)
        elif key in ("Left", "Up", "h", "k", "Page_Up"):
            self.change(-1)
        elif key in ("t", "Home"):
            self.change(0)


cal = Calendar()
popup.run("calendar-popup", cal.build, CSS, valign="start", top=TOP_GAP,
          on_key=cal.on_key, on_scroll=cal.on_scroll)
