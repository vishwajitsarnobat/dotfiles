#!/usr/bin/env python3
# Calendar card under the bar's clock. Run once to open, again to close
# (the clock's click does this). Scroll or use the arrows to change month,
# the dot to come back to today, Esc to close.
import calendar, datetime, os, signal, sys

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "calendar-popup.pid")

# Toggle: if a calendar is already open, close it and stop
try:
    pid = int(open(PIDFILE).read())
    if b"calendar-popup" in open(f"/proc/{pid}/cmdline", "rb").read():   # not a reused pid
        os.kill(pid, signal.SIGTERM)
        sys.exit(0)
except (OSError, ValueError):
    pass
open(PIDFILE, "w").write(str(os.getpid()))

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

TOP_GAP = 40            # bar height + margins, so the card sits just below it
FIRST_WEEKDAY = 6       # Sunday first, like the bar's old calendar

CSS = b"""
* { font-family: "Adwaita Sans"; }
window { background: transparent; }
#card {
    background: rgba(30, 30, 34, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 18px 18px 14px 18px;
    margin: 6px 12px 16px 12px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
}
#month { font-size: 17pt; font-weight: 700; color: #f2f2f5; }
#year  { font-size: 17pt; font-weight: 600; color: #8fb8f6; }
.nav {
    background: transparent; border: none; box-shadow: none;
    color: #a8a8b3; font-size: 13pt; font-weight: 700;
    min-width: 30px; min-height: 30px; padding: 0; border-radius: 999px;
}
.nav:hover { background: rgba(255, 255, 255, 0.08); color: #f2f2f5; }
.weekday { color: #6b6b76; font-size: 10pt; font-weight: 700; }
.day {
    color: #e3e3e8; font-size: 12pt; font-weight: 600;
    min-width: 38px; min-height: 38px; border-radius: 999px;
}
.day:hover   { background: rgba(255, 255, 255, 0.08); }
.weekend     { color: #a8a8b3; }
.other       { color: #4a4a54; }
.today       { background: #8fb8f6; color: #1e1e22; font-weight: 800; }
.today:hover { background: #a9c9fa; }
#footer { color: #a8a8b3; font-size: 10.5pt; font-weight: 500; }
#footer-week { color: #6b6b76; font-size: 10.5pt; font-weight: 600; }
"""


class CalendarCard(Gtk.Window):
    def __init__(self):
        super().__init__()
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "calendar-popup")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, TOP_GAP)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)

        screen = Gdk.Screen.get_default()
        self.set_visual(screen.get_rgba_visual())
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        today = datetime.date.today()
        self.year, self.month = today.year, today.month

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, name="card")
        self.add(card)

        header = Gtk.Box(spacing=8)
        self.month_label = Gtk.Label(name="month", xalign=0)
        self.year_label = Gtk.Label(name="year", xalign=0)
        header.pack_start(self.month_label, False, False, 0)
        header.pack_start(self.year_label, False, False, 0)
        for text, step in (("›", 1), ("•", 0), ("‹", -1)):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("nav")
            b.connect("clicked", lambda _b, s=step: self.change(s))
            header.pack_end(b, False, False, 0)
        card.pack_start(header, False, False, 0)

        self.grid = Gtk.Grid(row_spacing=2, column_spacing=4, column_homogeneous=True)
        card.pack_start(self.grid, False, False, 0)

        footer = Gtk.Box(spacing=8)
        footer.pack_start(Gtk.Label(label=today.strftime("%A, %-d %B %Y"), name="footer", xalign=0),
                          True, True, 0)
        footer.pack_end(Gtk.Label(label=f"Week {today.isocalendar()[1]}", name="footer-week"),
                        False, False, 0)
        card.pack_start(footer, False, False, 2)

        self.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("scroll-event", self.on_scroll)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", self.quit)
        self.scroll_acc = 0.0
        self.draw_month()

    def change(self, step):
        if step == 0:
            t = datetime.date.today()
            self.year, self.month = t.year, t.month
        else:
            y, m = divmod(self.year * 12 + self.month - 1 + step, 12)
            self.year, self.month = y, m + 1
        self.draw_month()

    def draw_month(self):
        for child in self.grid.get_children():
            self.grid.remove(child)
        self.month_label.set_text(calendar.month_name[self.month])
        self.year_label.set_text(str(self.year))

        cal = calendar.Calendar(firstweekday=FIRST_WEEKDAY)
        names = [calendar.day_abbr[(FIRST_WEEKDAY + i) % 7][:2] for i in range(7)]
        for col, name in enumerate(names):
            lbl = Gtk.Label(label=name)
            lbl.get_style_context().add_class("weekday")
            self.grid.attach(lbl, col, 0, 1, 1)

        today = datetime.date.today()
        weeks = cal.monthdatescalendar(self.year, self.month)
        while len(weeks) < 6:                     # always 6 rows, so the card never jumps
            last = weeks[-1][-1]
            weeks.append([last + datetime.timedelta(days=i + 1) for i in range(7)])
        for row, week in enumerate(weeks, start=1):
            for col, day in enumerate(week):
                lbl = Gtk.Label(label=str(day.day))
                ctx = lbl.get_style_context()
                ctx.add_class("day")
                if day.weekday() >= 5:
                    ctx.add_class("weekend")
                if day.month != self.month:
                    ctx.add_class("other")
                if day == today:
                    ctx.add_class("today")
                box = Gtk.EventBox()                # lets :hover work on the label
                box.add(lbl)
                self.grid.attach(box, col, row, 1, 1)
        self.grid.show_all()

    def on_scroll(self, _w, event):
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            self.scroll_acc += event.delta_y
            if abs(self.scroll_acc) >= 1:
                self.change(1 if self.scroll_acc > 0 else -1)
                self.scroll_acc = 0.0
        elif event.direction in (Gdk.ScrollDirection.DOWN, Gdk.ScrollDirection.RIGHT):
            self.change(1)
        elif event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            self.change(-1)
        return True

    def on_key(self, _w, event):
        key = Gdk.keyval_name(event.keyval)
        if key == "Escape":
            self.quit()
        elif key in ("Right", "Down", "l", "j", "Page_Down"):
            self.change(1)
        elif key in ("Left", "Up", "h", "k", "Page_Up"):
            self.change(-1)
        elif key in ("t", "Home"):
            self.change(0)
        return True

    def quit(self, *_):
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
        Gtk.main_quit()
        return False


win = CalendarCard()
try:
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import GLibUnix
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, win.quit)
except (ImportError, ValueError):                      # older GLib
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, win.quit)
win.show_all()
Gtk.main()
