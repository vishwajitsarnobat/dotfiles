#!/usr/bin/env bash
# settings-panel wifi | bluetooth | sound | power
STATE="${XDG_RUNTIME_DIR:-/tmp}/settings-panel"
if pgrep -f gnome-control-center >/dev/null && [ "$(cat "$STATE" 2>/dev/null)" = "$1" ]; then
    pkill -f gnome-control-center
    rm -f "$STATE"
    exit 0
fi
echo "$1" > "$STATE"
exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center "$1"
