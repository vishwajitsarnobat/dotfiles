#!/usr/bin/env bash
# theme light | theme dark | theme   (no word = flip)
KEY="org.gnome.desktop.interface color-scheme"
cur=$(gsettings get $KEY 2>/dev/null | tr -d "'")
case "${1:-toggle}" in
    dark)   mode=dark ;;
    light)  mode=light ;;
    toggle) if [ "$cur" = prefer-dark ]; then mode=light; else mode=dark; fi ;;
    *)      echo "Usage: theme [dark|light]"; exit 1 ;;
esac
if [ "$mode" = light ]; then
    gsettings set $KEY default;     msg="󰖨  Apps: light"
else
    gsettings set $KEY prefer-dark; msg="󰖔  Apps: dark"
fi
notify-send -a osd -u low "$msg" 2>/dev/null
