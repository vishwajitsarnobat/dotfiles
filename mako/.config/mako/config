font=Adwaita Sans, JetBrainsMono Nerd Font 12
format=<b>%s</b>\n%b
background-color=#1e1e22f7
text-color=#f2f2f5
border-color=#ffffff14
border-size=1
border-radius=12
padding=14,18
margin=10,12
outer-margin=6
width=380
max-icon-size=40
progress-color=over #8fb8f655
default-timeout=6000
max-history=30

[urgency=high]
border-color=#f2a1a8
default-timeout=0

# Do not disturb: hold notifications until it is off
[mode=do-not-disturb]
invisible=1
default-timeout=0
ignore-timeout=1

# Volume / brightness popup
[app-name=osd]
format=<b>%s</b>
width=260
padding=12,16
default-timeout=1200

[mode=do-not-disturb app-name=osd]
invisible=0

# Critical ones still show
[mode=do-not-disturb urgency=critical]
invisible=0
